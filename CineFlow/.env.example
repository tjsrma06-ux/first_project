# Copy this file to .env and replace DATABASE_PASSWORD before starting the app.
# .env is ignored by Git; this example is safe to commit and share.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cineflow
DATABASE_USERNAME=cineflow
DATABASE_PASSWORD=replace-with-a-local-password

REDIS_HOST=localhost
REDIS_PORT=6379

# Generate a random value in PowerShell:
# [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=1800
JWT_ISSUER=cineflow
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
